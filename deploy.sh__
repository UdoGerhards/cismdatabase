#!/usr/bin/env bash
set -e

# === Konfiguration ===
SERVER_USER="udogerhards"
SERVER_HOST="172.16.0.28"

PROJECT="cismdatabase"   # 👈 wichtig für Remote-Script
SERVER_BASE="/var/www/$PROJECT"

VERSION=$(date +"%Y%m%d-%H%M%S")
BUILD_DIR=".deploy-$PROJECT-$VERSION"
ARCHIVE_NAME="$PROJECT-$VERSION.tar.gz"

echo "Starte Deployment aus Projektverzeichnis..."
echo "Projekt: $PROJECT"
echo "Version: $VERSION"

# 1. Build-Verzeichnis vorbereiten
rm -rf "$BUILD_DIR"
mkdir "$BUILD_DIR"

# 2. Projektdateien kopieren
rsync -av \
  --exclude=".git" \
  --exclude=".github" \
  --exclude="node_modules" \
  --exclude="tests" \
  --exclude="*.md" \
  --exclude="*.log" \
  --exclude="logs" \
  --exclude=".env.local" \
  --exclude="deploy.sh" \
  ./ "$BUILD_DIR"

# 3. Produktionsabhängigkeiten installieren
(
  cd "$BUILD_DIR"
  npm install --omit=dev
)

# 4. Archiv erstellen
tar -czf "$ARCHIVE_NAME" -C "$BUILD_DIR" .

echo "Übertrage Archiv nach $SERVER_HOST..."
scp "$ARCHIVE_NAME" "$SERVER_USER@$SERVER_HOST:/tmp/"

echo "Führe Remote-Deployment aus..."
ssh "$SERVER_USER@$SERVER_HOST" \
  "sudo /var/www/deploy_remote.sh $PROJECT $VERSION $ARCHIVE_NAME"

echo "Bereinige lokale Build-Artefakte..."
rm -rf "$BUILD_DIR"
rm -f "$ARCHIVE_NAME"

echo "Deployment abgeschlossen!"